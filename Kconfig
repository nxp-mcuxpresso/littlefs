menuconfig MCUX_COMPONENT_middleware.littlefs
    bool "LittleFS"
    default n
    help
        This option will enable LittleFS Middleware component

config MCUX_COMPONENT_middleware.littlefs_mflash
    bool "LittleFS onchip flash"
    default n
    help
        This option will enable mflash driver for flash usage with littlefs